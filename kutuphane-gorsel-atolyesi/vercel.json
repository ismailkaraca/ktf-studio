{
  "version": 2,
  "functions": {
    "api/generate.js": {
      "maxDuration": 120
    },
    "api/covers.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
